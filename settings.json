{
  "group": { "en": "Beastmaster", "ru": "Повелитель зверей" },
  "hint": { "en": "An NPC that lets you adopt and manage pets; summon it with .beastmaster", "ru": "NPC, у которого можно взять и настроить питомцев; вызов командой .beastmaster" },
  "fields": [
    { "key": "BeastMaster.Enable", "type": "bool", "default": 1, "apply": "reload",
      "label": { "en": "Beastmaster enabled", "ru": "Повелитель зверей включён" } },
    { "key": "BeastMaster.HunterOnly", "type": "bool", "default": 1, "apply": "reload",
      "label": { "en": "Hunters only", "ru": "Только охотники" } },
    { "key": "BeastMaster.AllowedClasses", "type": "string", "default": "0", "apply": "reload",
      "label": { "en": "Classes that may adopt", "ru": "Классы, которым можно брать питомцев" },
      "hint": { "en": "Class ids separated by commas (1 warrior, 2 paladin, 3 hunter...); 0: all classes", "ru": "Id классов через запятую (1 воин, 2 паладин, 3 охотник...); 0: все классы" } },
    { "key": "BeastMaster.AllowedRaces", "type": "string", "default": "0", "apply": "reload",
      "label": { "en": "Races that may adopt", "ru": "Расы, которым можно брать питомцев" },
      "hint": { "en": "Race ids separated by commas (1 human, 2 orc...); 0: all races", "ru": "Id рас через запятую (1 человек, 2 орк...); 0: все расы" } },
    { "key": "BeastMaster.MinLevel", "type": "int", "min": 0, "default": 10, "apply": "reload",
      "label": { "en": "Minimum level to adopt", "ru": "Минимальный уровень" },
      "hint": { "en": "0: no minimum", "ru": "0: без ограничения" } },
    { "key": "BeastMaster.MaxLevel", "type": "int", "min": 0, "default": 0, "apply": "reload",
      "label": { "en": "Maximum level to adopt", "ru": "Максимальный уровень" },
      "hint": { "en": "0: no maximum", "ru": "0: без ограничения" } },
    { "key": "BeastMaster.HunterBeastMasteryRequired", "type": "bool", "default": 1, "apply": "reload",
      "label": { "en": "Exotic pets need Beast Mastery for hunters", "ru": "Охотнику для экзотических питомцев нужен талант «Повелитель зверей»" } },
    { "key": "BeastMaster.AllowExotic", "type": "bool", "default": 0, "apply": "reload",
      "label": { "en": "Exotic pets for other classes", "ru": "Экзотические питомцы для других классов" } },
    { "key": "BeastMaster.KeepPetHappy", "type": "bool", "default": 0, "apply": "reload",
      "label": { "en": "Pets are always happy", "ru": "Питомцы всегда довольны" } },
    { "key": "BeastMaster.TrackTamedPets", "type": "bool", "default": 0, "apply": "reload",
      "label": { "en": "Keep a list of tamed pets", "ru": "Вести список прирученных питомцев" },
      "hint": { "en": "Adds the My Tamed Pets menu, for all classes", "ru": "Добавляет меню «My Tamed Pets» для всех классов" } },
    { "key": "BeastMaster.MaxTrackedPets", "type": "int", "min": 0, "default": 20, "apply": "reload",
      "label": { "en": "Tamed pets in the list, at most", "ru": "Прирученных питомцев в списке, не больше" },
      "hint": { "en": "0: unlimited", "ru": "0: без ограничения" } },
    { "key": "BeastMaster.SummonCooldown", "type": "int", "min": 0, "default": 120, "apply": "reload",
      "label": { "en": "Summon cooldown, s", "ru": "Перезарядка вызова, с" } },
    { "key": "BeastMaster.ProfanityFilter", "type": "bool", "default": 1, "apply": "reload",
      "label": { "en": "Profanity filter for pet names", "ru": "Фильтр брани в именах питомцев" } },
    { "key": "BeastMaster.Howls", "type": "bool", "default": 1, "apply": "reload",
      "label": { "en": "Howl when you talk to the NPC", "ru": "Вой при разговоре с NPC" } },
    { "key": "BeastMaster.ShowLoginNotice", "type": "bool", "default": 1, "apply": "reload",
      "label": { "en": "Message on login", "ru": "Сообщение при входе" } },
    { "key": "BeastMaster.LoginMessage", "type": "string", "default": "", "apply": "reload",
      "label": { "en": "Own login message", "ru": "Своё сообщение при входе" },
      "hint": { "en": "Empty: the module's own message", "ru": "Пусто: сообщение модуля" } }
  ]
}
